# Copy to .env and pick the backend this build should talk to.
#
# Only EXPO_PUBLIC_-prefixed vars reach the app bundle. Changing this requires restarting the
# Expo dev server — it is inlined at build time, not read at runtime.
#
# Deployed API (also the built-in fallback when this file is absent):
EXPO_PUBLIC_API_BASE_URL=https://api-drive-sense.abhishek.homes
#
# Local Docker backend. Use this machine's LAN IP rather than localhost so a physical device on
# the same Wi-Fi can reach it; localhost only resolves for the iOS simulator and the web build.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.4:8000
