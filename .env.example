# Shared defaults for docker-compose and local dev.
# Copy to `.env` at the repo root to use with `docker compose`.

# Docker network
DOCKER_NETWORK_NAME=drivesense_network

# Database
POSTGRES_DB=drivesense
POSTGRES_USER=drivesense
POSTGRES_PASSWORD=drivesense
POSTGRES_HOST_PORT=15462

# Redis
REDIS_HOST_PORT=16382

# Backend
BACKEND_PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=local
