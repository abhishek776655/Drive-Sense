# App
APP_NAME="DriveSense API"
ENVIRONMENT=local
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Database
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=drivesense
POSTGRES_USER=drivesense
POSTGRES_PASSWORD=drivesense
SQLALCHEMY_ECHO=false

# Redis
REDIS_URL=redis://redis:6379/0

# Reverse geocoding (Photon / OpenStreetMap). Set REVERSE_GEOCODING_ENABLED=false to skip lookups,
# or point PHOTON_BASE_URL at a self-hosted Photon instance.
PHOTON_BASE_URL=https://photon.komoot.io
PHOTON_TIMEOUT_SECONDS=6.0
PHOTON_LANGUAGE=en
REVERSE_GEOCODING_ENABLED=true

# Auth (JWT)
JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7
